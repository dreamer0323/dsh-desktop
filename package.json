{
  "name": "dsh-desktop",
  "version": "0.1.0",
  "description": "Desktop wrapper for DeepSeek Harness (dsh web) — run the Web UI in a native window without opening a browser.",
  "private": true,
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "test:server": "node test/server-smoke.mjs",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "dev.dsh.desktop",
    "productName": "DeepSeek Harness Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "ui/**/*",
      "assets/**/*",
      "config.json",
      "package.json"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    }
  }
}